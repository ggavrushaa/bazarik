APP_NAME=Bazarik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Kyiv

APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bazarik
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@bazarik.com.ua"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Bazarik: умови магазину (значення в [дужках] з прототипу — ще на погодженні) ---
SHOP_FREE_DELIVERY_FROM=1500
SHOP_SAME_DAY_CUTOFF=15:00
SHOP_WARRANTY_MONTHS=12
SHOP_RETURN_DAYS=14
# SHOP_PHONE="+380 44 000 00 00"   # поки не задано — показуємо [+380 XX XXX XX XX]

# --- Інтеграції (заповнимо пізніше) ---
NOVAPOSHTA_API_KEY=
SMS_DRIVER=log
TURBOSMS_TOKEN=
TURBOSMS_SENDER=Bazarik
PAYMENT_PROVIDER=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
